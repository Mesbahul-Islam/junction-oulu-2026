# ===================================================================
#  AI model for the newsroom: fill in these lines
# ===================================================================
# Provider: ollama (local, no key), groq, gemini, openai, anthropic, mistral, openrouter ...
# Model:    the provider's model name, e.g.
#             ollama  -> qwen3:4b (small, CPU ok), qwen3.8:27b (needs a GPU / ~20 GB RAM)
#             groq    -> qwen/qwen3.8-27b, llama-3.3-70b-versatile
#             gemini  -> gemini-3.1-flash-lite
# Key:      that provider's API key (not needed for ollama).
#           (Leave LLM_MODEL empty to run offline, no AI.)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Ollama runs as a Docker service when this says "ollama" (download a model once:
#   docker compose exec ollama ollama pull qwen3:4b). Empty = no Ollama container.
COMPOSE_PROFILES=
# Already running Ollama on your computer instead? Set LLM_BASE_URL=http://host.docker.internal:11434
LLM_BASE_URL=

# ===================================================================
#  Feed personalisation with Jev (optional): key from console.typesafe.ai
# ===================================================================
TYPESAFE_API_KEY=

# ===================================================================
#  Usually fine as they are
# ===================================================================
SECRET_KEY=dev-insecure-change-me-to-a-long-random-string
DEBUG=True

# Stories per run, and minutes between automatic runs.
AGENT_SCHEDULE_MINUTES=30
AGENT_MAX_ITEMS=4

# First start imports the Liiga season for Fantasy Liiga (~3 min, needs internet). false = skip.
SEED_FANTASY=true

# Dev admin created on startup (local only).
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Reader app (frontend/): where the browser reaches the API, and which sites may call it.
# VITE_API_URL=http://localhost:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173   (in DEBUG every origin is allowed, e.g. phones on your LAN)

# Only for running without Docker (Docker sets these itself).
REDIS_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=True

# Optional: "Log in with Google" (OAuth app, not the Gemini key).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Fantasy Liiga stats API key (reads currently work without one).
LIIGAFI_API_KEY=

# More options (per-agent models, OpenAI-compatible servers, Jev tuning ...): docs/GUIDE.md §12

# Listen: stories read aloud by ElevenLabs (server-side only). Empty: the browser voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
