SECRET_KEY=dev-insecure-change-me-to-a-long-random-string
DEBUG=True
# Leave unset to use SQLite locally; docker-compose overrides this.
# Host-side ports of the docker-compose services (containers use db:5432 / redis:6379).
# DATABASE_URL=postgres://junction:junction@localhost:5433/junction
REDIS_URL=redis://localhost:6380/0
# Run Celery tasks inline (no worker/redis needed) for quick local demos.
CELERY_TASK_ALWAYS_EAGER=True

# "Log in with Google" (OAuth). Optional; unrelated to the Gemini key below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI newsroom agents use Google Gemini Flash (key from https://aistudio.google.com/apikey).
# Without a key the pipeline runs on a deterministic offline stub.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
AGENT_CONFIDENCE_THRESHOLD=0.7
AGENT_WEBHOOK_TOKEN=change-me

MARKETS_SIGNUP_GRANT=1000

# Feed personalisation with Jev (https://console.typesafe.ai/keys).
# Empty key = heuristic ranking only. FEED_RANKER=heuristic turns Jev off.
TYPESAFE_API_KEY=
FEED_RANKER=jev
JEV_MODEL=jev-latest
JEV_TOP_K=30
JEV_WEIGHT=0.6

# Dev admin created by `manage.py bootstrap` (local dev only; change for anything shared).
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
