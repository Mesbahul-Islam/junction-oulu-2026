# ===================================================================
#  AI model for the newsroom: fill in these lines
# ===================================================================
# Provider: ollama (local, no key), groq, gemini, openai, anthropic, mistral, openrouter ...
# Model:    the provider's model name, e.g.
#             ollama  -> qwen3:4b (small, CPU ok), qwen3.8:27b (needs a GPU / ~20 GB RAM)
#             groq    -> qwen/qwen3.8-27b, llama-3.3-70b-versatile
#             gemini  -> gemini-3.1-flash-lite
# Key:      that provider's API key (not needed for ollama).
#           (Leave LLM_MODEL empty to run offline, no AI.)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:0.8b
LLM_API_KEY=
# Previous groq setup, to switch back: LLM_PROVIDER=groq  LLM_MODEL=qwen/qwen3.8-27b  LLM_API_KEY=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
# Ollama runs as a Docker service when this says "ollama" (download a model once:
#   docker compose exec ollama ollama pull qwen3:4b). Empty = no Ollama container.
COMPOSE_PROFILES=
# Already running Ollama on your computer instead? Set LLM_BASE_URL=http://host.docker.internal:11434
LLM_BASE_URL=http://10.222.227.190:11434

